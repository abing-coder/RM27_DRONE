    pass
    {
      ambient 1 1 1 1
      diffuse 0.6 0.6 0.6 1
      texture_unit
      {
        texture rm_armor_outpost.png
        tex_address_mode clamp
      }
    }
  }
}

material RM/RedLightBar
{
  technique
  {
    pass
    {
      lighting on
      ambient 0 0 0 1
      diffuse 0 0 0 1
      emissive 0.85 0.01 0.01 1
    }
  }
}

material RM/BlueLightBar
