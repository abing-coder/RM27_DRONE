material RM/FieldGround { technique { pass { lighting on
ambient .8 .8 .8 1
 diffuse .8 .8 .8 1
texture_unit { texture rm_competition_floor.png
 tex_address_mode wrap
filtering anisotropic
 max_anisotropy 8
 }
 specular .02 .02 .02 1 8
 } } }

