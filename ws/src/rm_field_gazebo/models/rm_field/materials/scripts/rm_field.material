
material RM/Floor
{
  technique
  {
    pass
    {
      ambient 0.9 0.9 0.9 1
      diffuse 1 1 1 1
      specular 0.05 0.05 0.05 1 8
      texture_unit
      {
        texture rm_floor.png
        filtering anisotropic
        max_anisotropy 16
        scale 0.07142857142857142 0.13333333333333333
      }
    }
  }
}

material RM/Wood
{
  technique
  {
    pass
    {
      ambient 0.9 0.9 0.9 1
      diffuse 1 1 1 1
      texture_unit
      {
        texture rm_wood.png
        filtering anisotropic
        max_anisotropy 16
        scale 0.5 0.5
      }
    }
  }
}

material RM/Wall
{
  technique
  {
    pass
    {
      ambient 0.9 0.9 0.9 1
      diffuse 1 1 1 1
      texture_unit
      {
        texture rm_wall.png
        filtering anisotropic
        max_anisotropy 16
        scale 0.08 1.0
      }
    }
  }
}

material RM/ArmorBody
{
  technique
  {
    pass
    {
      ambient 0.05 0.05 0.06 1
      diffuse 0.05 0.05 0.06 1
    }
  }
}

material RM/BaseArmorFace
{
  technique
  {
    pass
    {
      ambient 1 1 1 1
      diffuse 0.6 0.6 0.6 1
      texture_unit
      {
        texture rm_armor_base.png
        tex_address_mode clamp
      }
    }
  }
}

material RM/OutpostArmorFace
{
  technique
