  <version>0.1.0</version>
  <description>RMUC2027 场地 Gazebo 世界</description>
  <maintainer email="dev@example.com">rm_drone</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>gazebo_ros</exec_depend>
