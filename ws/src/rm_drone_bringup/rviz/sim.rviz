Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 30
      Cell Size: 1
      Color: 80; 80; 80
      Line Style:
        Value: Lines
      Plane: XY
      Reference Frame: map
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.4
      Show Arrows: true
      Show Axes: true
      Show Names: false
    - Class: rviz_default_plugins/MarkerArray
      Name: Field
      Enabled: true
      Topic:
        Value: /field/markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Vision
      Enabled: true
      Topic:
        Value: /drone/vision/markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Plan
      Enabled: true
      Topic:
        Value: /drone/planner/markers
      Value: true
    - Class: rviz_default_plugins/Path
      Name: EstPath
      Enabled: true
      Topic:
        Value: /drone/est_path
      Color: 0; 200; 80
      Value: true
    - Class: rviz_default_plugins/Path
      Name: GtPath
      Enabled: true
      Topic:
        Value: /drone/gt_path
      Color: 80; 80; 255
      Value: true
    - Class: rviz_default_plugins/Path
      Name: VioPath
      Enabled: true
      Topic:
        Value: /drone/vio_path_map
      Color: 255; 160; 0
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Odom
      Enabled: true
      Topic:
        Value: /drone/odom
      Shape:
        Value: Axes
      Value: true
    - Class: rviz_default_plugins/Image
      Name: ColorCam
      Enabled: true
      Topic:
        Value: /drone/color/image_raw
      Max Value: 1
      Median window: 5
      Min Value: 0
      Value: true
    - Class: rviz_default_plugins/Image
      Name: DebugCam
      Enabled: true
      Topic:
        Value: /drone/vision/debug_image
      Value: true
    - Class: rviz_default_plugins/Image
      Name: DepthCam
      Enabled: true
      Topic:
        Value: /drone/depth/depth/image_raw
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 8
        Min Value: 0
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 80; 220; 255
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 8
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: DepthCloud
      Position Transformer: XYZ
      Queue Size: 2
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.02
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /drone/depth/points
      Unreliable: true
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 22
      Focal Point:
        X: 0
        Y: 0
        Z: 0.8
      Name: Current View
      Pitch: 0.7
      Yaw: 0.9
Window Geometry:
  Height: 900
  Width: 1600
  X: 50
  Y: 50
